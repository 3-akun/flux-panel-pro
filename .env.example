# Flux Panel Pro 环境变量 — 复制为 .env 后修改
APP_VERSION=2.0.0

# 面板端口
FRONTEND_PORT=6366
BACKEND_PORT=6365

# 数据库（安装脚本会自动生成随机值）
DB_NAME=flux_db
DB_USER=flux_user
DB_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# JWT 密钥（至少 32 字符随机字符串）
JWT_SECRET=change_me_jwt_secret_min_32_chars

# CORS：生产环境请设置为面板域名，多个用逗号分隔
CORS_ORIGINS=*

# HTTPS（配合 deploy/docker-compose.proxy.yml）
PANEL_DOMAIN=panel.example.com

# 首次部署后管理员账号（由 panel_install.sh 写入）
ADMIN_USER=admin
ADMIN_PASSWORD=
